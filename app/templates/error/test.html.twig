{# Template de test des pages d'erreur de Quernel Auto #}
{# Cette page permet de tester et prévisualiser toutes les pages d'erreur #}
{# Elle inclut : liens de prévisualisation, tests d'erreurs, instructions #}
{% extends 'base.html.twig' %}

{# Titre de la page pour le SEO #}
{% block title %}Test des pages d'erreur - Quernel Auto{% endblock %}

{# Feuilles de style spécifiques aux pages d'erreur #}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{# Contenu principal de la page de test #}
{% block body %}
    <div class="error-page-container">
        <article class="error-content">
            {# En-tête avec animation et icône #}
            <header class="error-animation">
                <div class="error-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <div class="error-code">TEST</div>
            </header>
            
            {# Section message principal #}
            <section class="error-message" aria-labelledby="error-title-main">
                <h1 id="error-title-main" class="error-title">Test des pages d'erreur</h1>
                <p class="error-description">
                    Cette page vous permet de tester toutes les pages d'erreur de l'application.
                    Utilisez les liens ci-dessous pour voir les pages d'erreur avec leur style complet.
                </p>
            </section>
            
            {# Section prévisualisations stylées #}
            <section class="error-suggestions" aria-labelledby="preview-title">
                <h3 id="preview-title">🎨 Prévisualisations stylées (recommandé) :</h3>
                <ul>
                    {# Liens vers les prévisualisations des pages d'erreur #}
                    <li><i class="fas fa-eye"></i> <a href="{{ path('app_preview_error_404') }}" style="color: var(--primary-color);">Voir la page d'erreur 404 stylée</a></li>
                    <li><i class="fas fa-eye"></i> <a href="{{ path('app_preview_error_403') }}" style="color: var(--primary-color);">Voir la page d'erreur 403 stylée</a></li>
                    <li><i class="fas fa-eye"></i> <a href="{{ path('app_preview_error_500') }}" style="color: var(--primary-color);">Voir la page d'erreur 500 stylée</a></li>
                    <li><i class="fas fa-eye"></i> <a href="{{ path('app_preview_error_generic') }}" style="color: var(--primary-color);">Voir la page d'erreur générique stylée</a></li>
                </ul>
            </section>
            
            {# Navigation avec boutons de prévisualisation (première ligne) #}
            <nav class="error-actions" aria-label="Actions de prévisualisation">
                <a href="{{ path('app_preview_error_404') }}" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                    Page 404 stylée
                </a>
                <a href="{{ path('app_preview_error_403') }}" class="btn btn-secondary">
                    <i class="fas fa-lock"></i>
                    Page 403 stylée
                </a>
            </nav>
            
            {# Navigation avec boutons de prévisualisation (deuxième ligne) #}
            <nav class="error-actions" aria-label="Actions de prévisualisation">
                <a href="{{ path('app_preview_error_500') }}" class="btn btn-primary">
                    <i class="fas fa-server"></i>
                    Page 500 stylée
                </a>
                <a href="{{ path('app_preview_error_generic') }}" class="btn btn-secondary">
                    <i class="fas fa-exclamation-triangle"></i>
                    Page générique stylée
                </a>
            </nav>
            
            {# Section tests avec vraies erreurs pour développeurs #}
            <section class="error-suggestions" aria-labelledby="debug-title">
                <h3 id="debug-title">⚠️ Tests avec vraies erreurs (pour développeurs) :</h3>
                <ul>
                    {# Liens pour déclencher de vraies erreurs #}
                    <li><i class="fas fa-bug"></i> <a href="{{ path('app_test_error_404') }}" style="color: var(--text-light);">Déclencher vraie erreur 404</a></li>
                    <li><i class="fas fa-bug"></i> <a href="{{ path('app_test_error_403') }}" style="color: var(--text-light);">Déclencher vraie erreur 403</a></li>
                    <li><i class="fas fa-bug"></i> <a href="{{ path('app_test_error_500') }}" style="color: var(--text-light);">Déclencher vraie erreur 500</a></li>
                    <li><i class="fas fa-bug"></i> <a href="{{ path('app_test_error_generic') }}" style="color: var(--text-light);">Déclencher vraie erreur générique</a></li>
                </ul>
            </section>
            
            {# Section instructions de test #}
            <section class="error-suggestions" aria-labelledby="instructions-title">
                <h3 id="instructions-title">Instructions de test :</h3>
                <ul>
                    {# Liste des instructions pour les tests #}
                    <li><i class="fas fa-info-circle"></i> Cette page n'est disponible qu'en mode développement</li>
                    <li><i class="fas fa-palette"></i> Les "prévisualisations stylées" montrent le design complet</li>
                    <li><i class="fas fa-mobile-alt"></i> Testez sur différentes tailles d'écran</li>
                    <li><i class="fas fa-mouse-pointer"></i> Vérifiez les animations et interactions</li>
                    <li><i class="fas fa-home"></i> Utilisez les boutons de retour pour revenir ici</li>
                </ul>
            </section>
            
            {# Pied de page avec bouton de retour #}
            <footer class="error-actions">
                <a href="{{ path('app_home') }}" class="btn btn-primary">
                    <i class="fas fa-home"></i>
                    Retour à l'accueil
                </a>
            </footer>
        </article>
    </div>
{% endblock %} 